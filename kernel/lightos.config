# LightOS changes to ROCKNIX 20250517's RK3326 config
# (projects/Rockchip/devices/RK3326/linux/linux.aarch64.conf), merged on top
# of it by tools/build_kernel.sh, which fails if one of these lines does not
# hold in the final .config (a dependency or a select overriding it).
#
# Only built-in (=y) code costs boot time and memory: the =m options are not
# built at all (no modules are installed), so they are left as they are.

# LightOS passes lightos/initrd.img; ROCKNIX builds its initramfs in.
CONFIG_INITRAMFS_SOURCE=""
CONFIG_LOCALVERSION="-lightos"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="lightos"

# Btrfs selects RAID6_PQ, whose benchmark took 510 ms of the boot (boot-15,
# dmesg 0.174 s to 0.684 s), and XOR_BLOCKS (another 10 ms). LightOS uses
# vfat; ext4 and squashfs stay for the root file system to come.
# CONFIG_BTRFS_FS is not set
# CONFIG_RAID6_PQ_BENCHMARK is not set
# CONFIG_NFS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_OVERLAY_FS is not set

# No network on the R36S beyond what userspace needs locally.
# CONFIG_IPV6 is not set

# The crypto API's DRBG (set =y in ROCKNIX's config, and selected through
# RNG_DEFAULT by echainiv, IPsec IV generation) builds in the jitter entropy
# RNG, whose start-up test took 156 ms (boot-16, initcall_debug). As modules
# they are not built; the kernel's own random number generator does not use
# them.
CONFIG_CRYPTO_ECHAINIV=m
CONFIG_CRYPTO_DRBG_MENU=m
CONFIG_CRYPTO_JITTERENTROPY=m

# Other RK3326 handhelds' joypads and keys: the R36S has
# rocknix-singleadc-joypad (built in by tools/build_kernel.sh, it has no
# Kconfig option), gpio-keys (volume) and the rk805 power key; its device
# tree has no odroidgo3-joypad or adc-joystick node.
# CONFIG_JOYSTICK_ODROIDGO3 is not set
# CONFIG_JOYSTICK_ANALOG is not set
# CONFIG_JOYSTICK_ADC is not set
# CONFIG_JOYSTICK_ODROIDGO2 is not set
# CONFIG_JOYSTICK_ODROIDGO2_V11 is not set
# CONFIG_JOYSTICK_RGB20S is not set
# CONFIG_JOYSTICK_XU10 is not set

# Other panels: the R36S panel is driven by panel-generic-dsi (built in by
# tools/build_kernel.sh, matched through the mipi-panel.dtbo overlay).
# CONFIG_DRM_PANEL_ELIDA_KD35T133 is not set
# CONFIG_DRM_PANEL_NEWVISION_NV3051D is not set
# CONFIG_DRM_PANEL_SITRONIX_ST7701 is not set
# CONFIG_DRM_PANEL_SITRONIX_ST7703 is not set
# CONFIG_DRM_PANEL_SIMPLE is not set

# Display outputs the RK3326 does not have or the R36S does not wire: only
# the VOP and the MIPI DSI host stay.
# CONFIG_ROCKCHIP_ANALOGIX_DP is not set
# CONFIG_ROCKCHIP_CDN_DP is not set
# CONFIG_ROCKCHIP_DW_HDMI is not set
# CONFIG_ROCKCHIP_INNO_HDMI is not set
# CONFIG_ROCKCHIP_LVDS is not set
# CONFIG_ROCKCHIP_RGB is not set
# CONFIG_ROCKCHIP_RK3066_HDMI is not set

# USB: the OTG port (dwc2) as a device for the mass storage gadget. The
# EHCI/OHCI host controller is disabled in the R36S device tree, and nothing
# is plugged into the OTG port as a host for now.
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_UAS is not set
# CONFIG_USB_ACM is not set
# CONFIG_USB_HID is not set
# CONFIG_USB_CONFIGFS_NCM is not set
# CONFIG_USB_CONFIGFS_ECM is not set
# CONFIG_USB_CONFIGFS_RNDIS is not set
# CONFIG_USB_CONFIGFS_F_FS is not set

# Virtualisation and server features.
# CONFIG_VFIO is not set
# CONFIG_EDAC is not set

# What LightOS uses, built in: listed so that the build fails if a change
# above (or a newer ROCKNIX config) drops one of them.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_IKCONFIG_PROC=y
# The card: the FAT partition (logs, the USB disk) and the file systems of
# the root to come.
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
# PMIC (rk817): regulators, power key, RTC, charger, sound.
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_INPUT_RK805_PWRKEY=y
CONFIG_RTC_DRV_RK808=y
CONFIG_CHARGER_RK817=y
CONFIG_SND_SOC_RK817=y
# Buttons and sticks: the joypad on the saradc and GPIOs, gpio-keys-vol,
# read through evdev.
CONFIG_INPUT_EVDEV=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_IIO=y
# adc-keys has no node in the R36S tree, but ROCKNIX's patch 0004 puts
# joypad_input_g there, which the joypad driver needs to link.
CONFIG_KEYBOARD_ADC=y
CONFIG_KEYBOARD_GPIO=y
# Display: VOP, MIPI DSI and its D-PHY, backlight, the text console.
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# The GPU (Mali-G31): Panfrost, for Mesa's GLES in the root file system.
# ROCKNIX builds it as a module.
CONFIG_DRM_PANFROST=y
# The SD card over the OTG port: dwc2 in device mode, the configfs mass
# storage gadget, the role switch.
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_F_MASS_STORAGE=y
# CPU frequency and temperature.
CONFIG_CPUFREQ_DT=y
CONFIG_ROCKCHIP_THERMAL=y
