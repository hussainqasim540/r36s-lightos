#!/lightos/bin/sh
# Lume's init (R36S): the first program of a Lume boot (rdinit=), and the
# same script again in the root file system. The project and its files on
# the card are still named LightOS (lightos/).
#
# U-Boot passes lightos/initrd.img with our kernel (lightos/Image, built by
# tools/build_kernel.sh) or ROCKNIX's KERNEL; that one unpacks it over its
# own built-in initramfs, and this script replaces ROCKNIX's /init.
#
# Stage 1 (the initramfs): with lightos/rootfs.sqfs on the card (Buildroot,
# tools/build_rootfs.sh), it copies it to RAM, mounts it and hands over to
# /lightos/init there, stage 2, which goes on below. Without it, or if that
# fails, stage 1 goes on by itself. The root file system holds the same
# /lightos tree (busybox and this script), plus Mesa, kmscube and ALSA.
#
# Then it
#   0. in stage 2 without a frontend, runs kmscube for 10 s on the GPU
#      (gpu.txt);
#   1. starts the frontend, if the card has it: slot in slot/, or Vesper
#      in vesper/ when lightos/frontend says "vesper"; or else
#      asks for each button in turn and logs its key code (keys.txt), then
#      shows any button until KEYS_MIN_SECONDS;
#   2. writes what it found to lightos/logs/boot-N on the FAT partition,
#      with the same counter as ROCKNIX's boots (mount-storage.sh);
#   3. powers off, or reboots, as the frontend asked, at once. If it
#      stopped by itself, or there is none, it says so for 10 s and powers
#      off (a reboot could loop).
# With lightos/usbdisk on the card (development), step 3 first shares that
# partition over the OTG port, like "LightOS SD via USB", and goes on when
# the computer ejects the card, or when no computer came: after the
# frontend within WAIT_PLUG s, otherwise within WAIT_HOST s; without its
# word it then reboots.
# U-Boot boots Lume at every power-on, and ROCKNIX once for ROCKNIX.TXT
# (boot.ini). VOL- held at power-on writes one: stage 1 checks the key as
# soon as it finds the FAT partition, writes ROCKNIX.TXT and reboots.
#
# With the boot logo in the initramfs (lightos/splash.fb.gz, from
# tools/lume_logo.py), stage 1 draws it on the frame buffer and the console
# stays quiet (the log keeps every line) until the frontend draws, or until a step
# that needs the screen: the button test, kmscube, the USB disk.
#
# If this script stops, the kernel panics and panic=10 reboots.

export PATH=/lightos/bin:/usr/bin:/usr/sbin:/bin:/sbin
WAIT_HOST=120
WAIT_PLUG=8
WAIT_GONE=20
LOG=/tmp/lightos-init.txt
G=/sys/kernel/config/usb_gadget/lightos

stage=1
[ -e /lightos/stage2 ] && stage=2
# Stage 2 gets /proc, /sys (with configfs) and /dev from stage 1.
[ $stage = 1 ] && mkdir -p /proc /sys /dev /tmp /flash
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config 2>/dev/null

up() { cut -d' ' -f1 /proc/uptime; }
# The boot logo: 640x480, 32 bits a pixel (XRGB8888, as the panel's frame
# buffer), gzipped. Only on a frame buffer with that line length.
quiet=${LUME_QUIET:-no}
if [ $stage = 1 ]; then
  printf '\033[2J\033[H'
  if [ -f /lightos/splash.fb.gz ] && [ "$(cat /sys/class/graphics/fb0/stride 2>/dev/null)" = 2560 ] &&
     zcat /lightos/splash.fb.gz > /dev/fb0 2>/dev/null; then
    quiet=yes
  fi
fi
export LUME_QUIET=$quiet
say() { [ $quiet = yes ] || echo "$*"; echo "$(up) $*" >> $LOG; }
# The console again, over the logo, for a step that shows text.
loud() {
  if [ $quiet = yes ]; then
    quiet=no
    export LUME_QUIET=no
    printf '\033[2J\033[H'
  fi
}
t_init=$(up)

if [ $stage = 1 ]; then
  say "Lume, R36S (busybox initramfs, $(uname -r))"
  [ $quiet = yes ] && say "boot logo drawn at ${t_init} s"
  say "init started at ${t_init} s"
else
  say "Stage 2 (root file system) started at ${t_init} s"
fi

# The FAT partition (ROCKNIX's /flash): logs, the USB disk, and whether to
# run the guided button test.
part=
i=0
while [ $i -lt 50 ]; do
  part=$(findfs LABEL=ROCKNIX 2>/dev/null) && [ -b "$part" ] && break
  part=
  usleep 100000
  i=$((i + 1))
done
if [ -z "$part" ]; then
  loud
  say "No FAT partition labelled ROCKNIX: no logs, no USB disk."
  sleep 10
  reboot -f
fi

# VOL- held at power-on: ROCKNIX, once. boot.ini's "gpio input c1" does
# not see the key on this console (boot-56, boot-57), and reading GPIO2's
# registers from boot.ini hung U-Boot (a black screen), so Lume reads it.
# Not from the event device: gpio-keys reports the keys already down only
# to its first opener, the console's kbd handler at 1.01 s (boot-58 to
# boot-60 saw nothing). debugfs's gpio list gives each requested line's
# level as the pin reads it: VOL- is active low, so held is "in  lo". The
# line goes to the log at every boot. If held, init writes ROCKNIX.TXT as
# tools/rocknix_once.sh does, "R" and a new token, and reboots; boot.ini
# boots ROCKNIX for a token it has not booted yet. GPIO_DEBUG is for
# tools/test_init_stages.sh.
GPIO_DEBUG=${GPIO_DEBUG:-/sys/kernel/debug/gpio}
vol_down_held() {
  [ -e $GPIO_DEBUG ] || mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
  line=$(grep '|VOLUMEDOWN ' $GPIO_DEBUG 2>/dev/null)
  say "VOL-:${line:- no VOLUMEDOWN line in $GPIO_DEBUG}"
  case "$line" in
    *") in  lo "*) return 0 ;;
  esac
  return 1
}
if [ $stage = 1 ] && vol_down_held; then
  loud
  say "VOL- held: restarting into ROCKNIX, once."
  if mount -t vfat -o rw "$part" /flash; then
    {
      echo "R $(date +%Y%m%dT%H%M%S) $(cat /proc/sys/kernel/random/uuid)"
      cat /flash/lightos/rocknix.txt 2>/dev/null
      echo "Written by Lume's init: VOL- was held at power-on."
    } > /flash/ROCKNIX.TXT
    sync
    umount /flash
    sleep 1
    reboot -f
  fi
  say "Could not mount $part: going on with Lume."
fi

# 0. Stage 1 hands over to the root file system on the card, if there is
# one. It runs from RAM, so the card is free for the logs and the USB disk.
if [ $stage = 1 ] && mount -t vfat -o ro "$part" /flash; then
  if [ -f /flash/lightos/rootfs.sqfs ]; then
    t0=$(up)
    if cp /flash/lightos/rootfs.sqfs /rootfs.sqfs; then
      umount /flash
      mkdir -p /newroot
      if mount -t squashfs -o loop,ro /rootfs.sqfs /newroot && [ -x /newroot/lightos/init ]; then
        say "Root file system: lightos/rootfs.sqfs, $(( $(wc -c < /rootfs.sqfs) / 1024 )) KiB, copied from ${t0} s to $(up) s"
        mount -t tmpfs tmpfs /newroot/tmp
        cp $LOG /newroot$LOG
        mount --move /dev /newroot/dev
        mount --move /proc /newroot/proc
        mount --move /sys /newroot/sys
        # busybox's switch_root, before it empties the initramfs, wants a
        # regular file /init there to be sure that it is one (ours starts
        # with rdinit=/lightos/init and has none).
        [ -f /init ] || : > /init
        exec switch_root /newroot /lightos/init
      fi
      say "Could not mount lightos/rootfs.sqfs: going on in stage 1."
      umount /newroot 2>/dev/null
    else
      say "Could not copy lightos/rootfs.sqfs: going on in stage 1."
    fi
    rm -f /rootfs.sqfs
  fi
  umount /flash 2>/dev/null
fi
guided=no
gputrace=no
fe=slot
fe_run=no
slottrace=no
usbdisk=no
# The kernel's random number generator: the RK3326 has no hardware RNG
# the kernel uses, so it was ready ("crng init done") only 5.6 to 10 s
# after power-on, and until then getrandom() blocks. Mesa's drirc parser
# (expat, its hash salt) waited 3.5 s for it in kmscube (boot-32,
# strace). In stage 2, seedrng (Buildroot's busybox) credits the seed
# saved on the card at the previous boot and saves a new one; step 2 saves
# it again once the generator is ready, so that the next boot can credit
# it.
seed=no
[ $stage = 2 ] && command -v seedrng >/dev/null && seed=yes
if [ $seed = yes ] && mount -t vfat -o rw,noatime "$part" /flash || mount -t vfat -o ro "$part" /flash; then
  [ -e /flash/lightos/keytest ] && guided=yes
  [ -e /flash/lightos/gputrace ] && gputrace=yes
  [ -e /flash/lightos/usbdisk ] && usbdisk=yes
  if [ -e /flash/lightos/slottrace ]; then
    slottrace=yes
    read traceafter < /flash/lightos/slottrace
  fi
  # The frontend: slot (its R36S build, dist-r36s/slot of slot-r36s) in
  # slot/ on the FAT partition, or Vesper (build/card/vesper of
  # r36s-handheld) in vesper/ when lightos/frontend holds "vesper". Stage
  # 2 starts it in place of the self-tests and the button test, unless the
  # card holds lightos/keytest or lightos/noslot (which stops either).
  # Its first word; a file saved on Windows may end its lines with CR.
  [ -f /flash/lightos/frontend ] && fe=$(head -n 1 /flash/lightos/frontend | tr -d "\r" | cut -d" " -f1)
  case $fe in
    vesper) fe_bin=bin/vesper fe_logs=logs ;;
    *) fe=slot fe_bin=System/slot fe_logs=Logs ;;
  esac
  [ $stage = 2 ] && [ $guided = no ] && [ -f /flash/$fe/$fe_bin ] && [ ! -e /flash/lightos/noslot ] && fe_run=yes
  if [ $seed = yes ]; then
    t0=$(up)
    out=$(seedrng -d /flash/lightos/seed 2>&1 | tr '\n' ' ')
    sync
    say "seedrng from ${t0} s to $(up) s: ${out}"
  fi
  umount /flash
fi

# 0. The GPU, in stage 2: kmscube draws through Mesa's Panfrost on the
# panel for 600 frames (10 s at 60 Hz), killed after 20 s if it hangs. What
# it prints (the EGL and GL renderer, the mode) goes to gpu.txt.
GPU=/tmp/gpu.txt
: > $GPU
# run_kmscube FRAMES [COMMAND...]: kmscube -c FRAMES, under COMMAND if one
# is given (strace), at most 20 s.
run_kmscube() {
  n=$1; shift
  t0=$(up)
  # kmscube stops at the first input on its stdin ("user interrupted!",
  # boot-29 after 4.4 s, on the console): its stdin is a FIFO opened read
  # and write, which never has anything to read. (Not a pipe from sleep:
  # ash's wait would then wait for the sleep too.) Mesa's shader cache goes
  # to /tmp (the root is read-only).
  [ -p /tmp/kmscube.in ] || mkfifo /tmp/kmscube.in
  XDG_CACHE_HOME=/tmp/cache "$@" kmscube -c $n <> /tmp/kmscube.in >> $GPU 2>&1 &
  k=$!
  i=0
  while kill -0 $k 2>/dev/null && [ $i -lt 200 ]; do
    usleep 100000
    i=$((i + 1))
  done
  if kill -0 $k 2>/dev/null; then
    kill $k
    # strace, killed, leaves kmscube running: it would keep the display.
    killall kmscube 2>/dev/null
    echo "== killed after 20 s" >> $GPU
  fi
  wait $k
  echo "== exit $?, from ${t0} s to $(up) s" >> $GPU
}
if [ $stage = 2 ] && [ $fe_run = no ] && command -v kmscube >/dev/null; then
  loud
  { echo "== /sys/class/drm"; ls /sys/class/drm
    echo "== modetest -c (connectors)"; modetest -M rockchip -c 2>&1 | head -n 20; } >> $GPU 2>&1
  # With lightos/gputrace on the card: where kmscube's first 4.8 s go
  # (boot-31: 14.8 s for 10 s of frames). Three runs of 120 frames under
  # strace (-ttt -T: each system call's time and length), in the logs as
  # strace-N.txt: everything cold; again, with Mesa's shader cache and the
  # files in the page cache; again after dropping the page cache, so the
  # libraries are read from the squashfs again but the shader cache is warm.
  if [ $gputrace = yes ] && command -v strace >/dev/null; then
    say "GPU trace: kmscube under strace, three runs"
    for t in 1 2 3; do
      if [ $t = 3 ]; then sync; echo 3 > /proc/sys/vm/drop_caches; fi
      echo "== trace $t" >> $GPU
      run_kmscube 120 strace -f -ttt -T -o /tmp/strace-$t.txt
    done
    { echo "== /tmp/cache"; du -a /tmp/cache; } >> $GPU 2>&1
    say "GPU trace: $(grep -c "" /tmp/strace-1.txt) system calls in run 1, done at $(up) s"
  fi
  say "GPU: kmscube, 600 frames"
  echo "== kmscube" >> $GPU
  run_kmscube 600
  # kmscube prints 'renderer: "Mali-G31 MC1 (Panfrost)"' and, every 2 s
  # and at the end, "Rendered N frames in T sec (F fps)".
  r=$(sed -n 's/^ *renderer: "\(.*\)"$/\1/p' $GPU | head -n 1)
  f=$(grep "^Rendered " $GPU | tail -n 1)
  say "GPU: kmscube from ${t0} s to $(up) s, ${r:-no renderer}, ${f:-no frames}"
  printf '\033[2J\033[H'
fi

# 1a. The frontend, instead of the button test (see fe_run=yes above).
# Its card folder ($FE: slot/ or vesper/) is on the FAT partition, mounted
# read-write for as long as it runs; its log is slot/Logs/slot.log or
# vesper/logs/vesper.log, and the boot's logs get a copy. Vesper gets the
# same shims, clocks and codec settings as slot, and VESPER_ROOT for its
# folder; the trace (lightos/slottrace) is slot's only.
# The environment is the one slot's ArkOS launcher (r36s/card/System/
# r36s-launch.sh) sets. slot sets the volume itself, in software, so the
# codec goes to full. This R36S's speaker is on the codec's headphone
# output (HP), not on its class D (SPK): boot-34 to boot-36 played a tone
# on each, and only HP came out of the speaker.
# The frontend powers off with poweroff(8) and restarts with reboot(8):
# here both end it, init writes which one it asked for, and goes on with
# the logs and the USB disk, then reboots.
# slot's log is written to /tmp while it runs and copied to the card when
# it exits: slot syncs the file system of its log every second while the
# log grows, and on the card that costs frames. With lightos/slottrace on
# the card, slot traces its pacing, audio and input latency
# (SLOT_TRACE, SLOT_TRACE_LATENCY), and init samples the clocks, the
# temperatures, the interrupts and the sound card's hardware pointer once
# a second (sys.txt in the logs: the pointer's steps are the codec's real
# sample rate), and slot prints the phases of each frame that missed a
# flip (SLOT_TRACE_FRAMES). After 60 s (or the number of seconds written in
# lightos/slottrace), strace follows every thread of slot for 20 s
# (strace-slot.txt), with each thread's name and context switches before
# and after (slot-threads.txt).
PCM=/proc/asound/card0/pcm0p/sub0
sample() {
  echo "uptime cpu_mhz gpu_mhz soc_c gpu_c ctxt intr running hw_ptr"
  n=0
  while :; do
    cf=0 gf=0 st=0 gt=0 hp=0
    read u _ < /proc/uptime
    read cf < /sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq
    read gf < /sys/class/devfreq/ff400000.gpu/cur_freq
    read st < /sys/class/thermal/thermal_zone0/temp
    read gt < /sys/class/thermal/thermal_zone1/temp
    while read k v _; do
      case $k in ctxt) c=$v ;; intr) i=$v ;; procs_running) r=$v ;; esac
    done < /proc/stat
    [ -f $PCM/status ] && while read k _ v; do
      case $k in hw_ptr) hp=$v ;; esac
    done < $PCM/status
    echo "$u $((${cf:-0} / 1000)) $((${gf:-0} / 1000000)) $((${st:-0} / 1000)) $((${gt:-0} / 1000)) $c $i $r $hp"
    n=$((n + 1))
    [ $n = 20 ] && cat $PCM/hw_params $PCM/sw_params > /tmp/sys-alsa.txt 2>&1
    sleep 1
  done
}
threads() {
  for t in /proc/$1/task/*; do
    echo "${t##*/} $(cat $t/comm) $(grep ctxt_switches $t/status | tr -s '\t\n' '  ')"
  done
}
trace_slot() {
  sleep $1
  pid=$(pidof slot) || return
  { echo "== before"; threads $pid; } > /tmp/slot-threads.txt
  args=
  for t in /proc/$pid/task/*; do args="$args -p ${t##*/}"; done
  timeout -s INT 20 strace -tt -T -o /tmp/strace-slot.txt $args 2>/dev/null
  { echo "== after"; threads $pid; } >> /tmp/slot-threads.txt
}
snapshot() {
  echo "== $1 at $(up) s"
  cat /proc/interrupts
  for d in /sys/devices/system/cpu/cpu[0-9]*/cpuidle/state*; do
    [ -d $d ] && echo "${d#/sys/devices/system/cpu/} $(cat $d/name) usage $(cat $d/usage) time $(cat $d/time) us"
  done
  for d in /sys/class/thermal/cooling_device*; do
    [ -d $d ] && echo "${d##*/} $(cat $d/type) state $(cat $d/cur_state)/$(cat $d/max_state)"
  done
}
FE=/flash/$fe
if [ $fe_run = yes ]; then
  if mount -t vfat -o rw,noatime "$part" /flash; then
    mountpoint -q /run || mount -t tmpfs tmpfs /run
    # Mesa's shader cache on the card, so that the frontend's shaders are
    # compiled once and not at every boot (in /tmp it starts empty each time).
    mkdir -p /tmp/data /flash/lightos/cache /tmp/fe-shims $FE/$fe_logs
    # The frontend's poweroff and reboot, once it has saved and synced
    # everything: the shim notes which, and stops the frontend. With
    # SIGKILL: slot then sleeps 10 s to be killed by the system, and on
    # SIGTERM it only sets a flag that its main thread, in that sleep, does
    # not see (boot-59, boot-60: 10 s from slot's "poweroff" to its exit).
    # Vesper runs them from its own process, so $PPID is Vesper too.
    for c in poweroff reboot; do
      printf '#!/bin/sh\necho %s > /tmp/frontend-exit\nkill -KILL $PPID\nexit 0\n' $c > /tmp/fe-shims/$c
      chmod +x /tmp/fe-shims/$c
    done
    # Full clocks while the frontend runs, as slot's ArkOS launcher does:
    # performance for every devfreq device that has it (the DDR, the GPU).
    for g in /sys/class/devfreq/*/governor; do
      grep -qw performance ${g%governor}available_governors 2>/dev/null && echo performance > $g
    done
    say "$fe: devfreq $(for d in /sys/class/devfreq/*; do echo -n "${d##*/} $(cat $d/governor) $(( $(cat $d/cur_freq) / 1000000 )) MHz; "; done)"
    amixer -q -c 0 cset name='Playback Mux' HP 2>/dev/null
    amixer -q -c 0 cset name='Master Playback Volume' 100% 2>/dev/null
    [ -f $FE/$fe_logs/$fe.log ] && mv -f $FE/$fe_logs/$fe.log $FE/$fe_logs/$fe.log.1
    trace=
    if [ $fe = slot ] && [ $slottrace = yes ]; then
      trace="SLOT_TRACE=1 SLOT_TRACE_LATENCY=1 SLOT_TRACE_FRAMES=1"
      snapshot start > /tmp/sys-snap.txt 2>&1
      sample > /tmp/sys.txt 2>&1 &
      sampler=$!
      case $traceafter in ''|*[!0-9]*) traceafter=60 ;; esac
      command -v strace >/dev/null && trace_slot $traceafter &
    fi
    t0=$(up)
    say "$fe: started at ${t0} s${trace:+, with $trace}"
    if [ $fe = vesper ]; then
      env PATH=/tmp/fe-shims:$PATH HOME=/tmp XDG_CACHE_HOME=/flash/lightos/cache \
        VESPER_ROOT=$FE \
        $FE/$fe_bin < /dev/null > /tmp/$fe.log 2>&1
    else
      env PATH=/tmp/fe-shims:$PATH HOME=/tmp XDG_CACHE_HOME=/flash/lightos/cache \
        SLOT_ROOT=$FE SLOT_RUN=/run BASEOS_TARGET=r36s BASEOS_MODEL=R36S \
        SLOT_GBA_CORE=gpsp SLOT_PACER=off $trace \
        $FE/$fe_bin < /dev/null > /tmp/$fe.log 2>&1
    fi
    st=$?
    say "$fe: exited with $st at $(up) s$([ -f /tmp/frontend-exit ] && echo ", after asking for $(cat /tmp/frontend-exit)")"
    if [ $fe = slot ] && [ $slottrace = yes ]; then
      kill $sampler
      snapshot end >> /tmp/sys-snap.txt 2>&1
      say "slot: $(grep -c "^slot: latency:" /tmp/slot.log) latency lines, $(grep "^slot: pace:" /tmp/slot.log | wc -l) pace lines"
    fi
    cp /tmp/$fe.log $FE/$fe_logs/$fe.log
    sync
    umount /flash
  else
    say "$fe: could not mount $part read-write"
  fi
  printf '\033[2J\033[H'
fi

# 1b. The button test, when no frontend runs.
if [ $fe_run = no ]; then
  loud
  say ""
  readers=
  for ev in /dev/input/event*; do
    [ -c "$ev" ] || continue
    name=$(cat /sys/class/input/${ev##*/}/device/name 2>/dev/null)
    say "  ${ev##*/}: $name"
    (
      while :; do
        set -- $(dd if=$ev bs=24 count=1 2>/dev/null | od -An -tu2)
        [ $# -ge 11 ] || exit 0
        [ "$9" = 1 ] && [ "${11}" = 1 ] && echo "$(up) ${10} $name" >> $RAW
      done
    ) &
    readers="$readers $!"
  done
  sleep 2

  t_keys=$(secs)
  n_steps=$(echo "$STEPS" | wc -l)
  i=0
  [ $guided = yes ] || STEPS=
  while read -r step; do
    [ -n "$step" ] || continue
    i=$((i + 1))
    seen=$(lines)
    printf '\033[2J\033[H'
    echo "LightOS button test: $i of $n_steps"
    echo ""
    echo "    Press:  $step"
    echo ""
    echo "($STEP_SECONDS s for each button; wait to skip one)"
    echo ""
    tail -n 18 $KEYS
    got=
    tick=0
    while [ $tick -lt $((STEP_SECONDS * 10)) ]; do
      if [ "$(lines)" -gt "$seen" ]; then
        got=$(sed -n "$((seen + 1))p" $RAW)
        break
      fi
      usleep 100000
      tick=$((tick + 1))
    done
    if [ -n "$got" ]; then
      set -- $got
      shift
      code=$1
      shift
      echo "$step: $code ($*)" >> $KEYS
    else
      echo "$step: not pressed" >> $KEYS
    fi
    # Anything else that came with that press (bounce) is not the next step.
    usleep 300000
  done <<EOF_STEPS
$STEPS
EOF_STEPS

  printf '\033[2J\033[H'
  cat $KEYS
  echo ""
  echo "Free test: any button shows here until $KEYS_MIN_SECONDS s."
  seen=$(lines)
  while [ $(( $(secs) - t_keys )) -lt $KEYS_MIN_SECONDS ]; do
    now=$(lines)
    if [ "$now" -gt "$seen" ]; then
      sed -n "$((seen + 1)),${now}p" $RAW | while read -r t code dev; do
        echo "  key $code on $dev"
      done
      seen=$now
    fi
    usleep 200000
  done
  kill $readers 2>/dev/null
  killall dd 2>/dev/null
  printf '\033[2J\033[H'
  say "Button test done ($(( $(secs) - t_keys )) s)."
  cat $KEYS >> $LOG
fi

# 2. Logs on the FAT partition.

hardware() {
  echo "== uptime"; cat /proc/uptime
  echo "== uname"; uname -a
  echo "== stage"; echo $stage; cat /lightos/stage2 /etc/os-release 2>/dev/null
  echo "== cmdline"; cat /proc/cmdline
  echo "== ROCKNIX.TXT, first line"
  head -n 1 /flash/ROCKNIX.TXT 2>/dev/null
  echo "== sector 31 of $part (U-Boot's copy of the last one-shot token it booted)"
  dd if=$part bs=512 skip=31 count=1 2>/dev/null | head -n 1
  echo "== panel node"
  panel=/proc/device-tree/dsi@ff450000/panel@0
  tr '\0' ' ' < $panel/compatible; echo
  [ -e $panel/panel_description ] && echo "panel_description present: the overlay was applied"
  [ -e $panel/panel_description ] && tr '\0' '\n' < $panel/panel_description | head -n 1
  for c in /sys/class/drm/card*-*; do
    [ -d "$c" ] || continue
    echo "== $c"
    echo "status=$(cat $c/status) enabled=$(cat $c/enabled) dpms=$(cat $c/dpms)"
    cat $c/modes
  done
  for b in /sys/class/backlight/*; do
    [ -d "$b" ] || continue
    echo "== $b"
    for f in brightness actual_brightness max_brightness bl_power; do
      echo "$f=$(cat $b/$f)"
    done
  done
  echo "== input"; cat /proc/bus/input/devices
  echo "== cpufreq"
  for f in scaling_governor scaling_cur_freq scaling_available_frequencies \
           scaling_available_governors; do
    echo "$f=$(cat /sys/devices/system/cpu/cpu0/cpufreq/$f 2>/dev/null)"
  done
  echo "== devfreq"
  for d in /sys/class/devfreq/*; do
    [ -d "$d" ] && echo "${d##*/} cur=$(cat $d/cur_freq) available=$(cat $d/available_frequencies)"
  done
  echo "== thermal"
  for z in /sys/class/thermal/thermal_zone*; do
    [ -d "$z" ] && echo "${z##*/} $(cat $z/type)=$(cat $z/temp)"
  done
  echo "== power supply"
  for p in /sys/class/power_supply/*; do
    [ -d "$p" ] && echo "-- ${p##*/}" && cat $p/uevent
  done
  echo "== memory"; cat /proc/meminfo
  echo "== mounts"; cat /proc/mounts
  echo "== block"; cat /proc/partitions
  echo "== usb device controller"; ls /sys/class/udc
}

if mount -t vfat -o rw,noatime "$part" /flash; then
  logs=/flash/lightos/logs
  mkdir -p $logs
  count=$(cat $logs/count 2>/dev/null)
  count=$(( ${count:-0} + 1 ))
  echo $count > $logs/count
  for old in $logs/boot-*; do
    [ -d "$old" ] && [ "${old##*-}" -le $(( count - 5 )) ] && rm -rf "$old"
  done
  dir=$logs/boot-$count
  mkdir -p $dir
  say "Logs: lightos/logs/boot-$count"
  case $(uname -r) in
    *-lightos) kernel="LightOS kernel" ;;
    *) kernel="ROCKNIX's kernel" ;;
  esac
  if [ $stage = 2 ]; then
    echo "LightOS stage 2 (Buildroot root file system on $kernel $(uname -r))" > $dir/os.txt
  else
    echo "LightOS stage 1 (busybox initramfs on $kernel $(uname -r))" > $dir/os.txt
  fi
  if [ $seed = yes ]; then
    say "seedrng: $(seedrng -d /flash/lightos/seed 2>&1 | tr '\n' ' ')$(dmesg | grep -m1 "crng init done" | sed 's/^/(kernel: /; s/$/)/')"
  fi
  hardware > $dir/hardware.txt 2>&1
  dmesg > $dir/dmesg.txt
  cp $LOG $dir/init.txt
  cp $KEYS $dir/keys.txt
  cp $RAW $dir/keys-raw.txt
  [ -s $GPU ] && cp $GPU $dir/gpu.txt
  [ -f /tmp/$fe.log ] && cp /tmp/$fe.log $dir/$fe.log
  for f in /tmp/sys.txt /tmp/sys-snap.txt /tmp/sys-alsa.txt /tmp/slot-threads.txt; do [ -f $f ] && cp $f $dir/; done
  for f in /tmp/strace-*.txt; do [ -f $f ] && cp $f $dir/; done
  sync
  umount /flash
else
  say "Could not mount $part: no logs."
fi

# 3. The end: what the frontend asked for (poweroff or reboot). Without its
# word, poweroff, or with lightos/usbdisk a reboot, as before that file. With
# lightos/usbdisk, the partition goes on the OTG port first; after it the
# computer has WAIT_PLUG s to show up. (The rk817 charger is no sign of a
# cable: boot-54 had it offline with the computer on the OTG port.)
ending=poweroff
wait_host=$WAIT_HOST
if [ -f /tmp/frontend-exit ]; then
  wait_host=$WAIT_PLUG
  [ "$(cat /tmp/frontend-exit)" = poweroff ] || ending=reboot
elif [ $usbdisk = yes ]; then
  ending=reboot
fi
finish() {
  say "$1"
  sync
  sleep ${2:-0}
  $ending -f
}
if [ $usbdisk = no ]; then
  if [ ! -f /tmp/frontend-exit ]; then
    loud
    finish "Stopped without $fe asking to: ${ending} in 10 s." 10
  fi
  finish "${ending}."
fi
loud
UDC=$(ls -1 /sys/class/udc 2>/dev/null | head -n1)
if [ -z "$UDC" ] || [ ! -d /sys/kernel/config/usb_gadget ]; then
  finish "No USB device controller or configfs: no USB disk." 10
fi

role() {
  for sw in /sys/class/udc/$UDC/device/usb_role/*/role; do
    [ -w "$sw" ] && echo "$1" > "$sw"
  done
}

mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/mass_storage.0
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo 0x0200 > $G/bcdUSB
echo "Lume" > $G/strings/0x409/manufacturer
echo "R36S SD (Lume)" > $G/strings/0x409/product
echo "mass storage" > $G/configs/c.1/strings/0x409/configuration
echo 250 > $G/configs/c.1/MaxPower
lun=$G/functions/mass_storage.0/lun.0
echo 1 > $lun/removable
echo 0 > $lun/ro
echo 0 > $lun/cdrom
echo "$part" > $lun/file
ln -s $G/functions/mass_storage.0 $G/configs/c.1/

role device
if ! echo "$UDC" > $G/UDC; then
  finish "Could not start the USB disk on $UDC." 10
fi
say ""
say "SD card on the OTG port: plug in the computer"
say "within ${wait_host} s, eject it when done."
say "Then: ${ending}."

waited=0
seen=no
gone=0
while :; do
  state=$(cat /sys/class/udc/$UDC/state 2>/dev/null)
  file=$(cat $lun/file 2>/dev/null)
  if [ "$state" = configured ]; then
    [ $seen = no ] && say "Computer connected."
    seen=yes
    gone=0
  elif [ $seen = yes ]; then
    gone=$((gone + 1))
  fi
  if [ $seen = yes ] && [ -z "$file" ]; then
    say "Ejected by the computer."
    break
  fi
  if [ $seen = yes ] && [ $gone -ge $WAIT_GONE ]; then
    say "Cable gone for ${WAIT_GONE} s."
    break
  fi
  if [ $seen = no ] && [ $waited -ge $wait_host ]; then
    say "No computer after ${wait_host} s."
    break
  fi
  sleep 1
  waited=$((waited + 1))
done

echo "" > $G/UDC 2>/dev/null
role host
finish "${ending}." 2
