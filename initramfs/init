#!/lightos/bin/sh
# R36S LightOS, stage 1: the first program of a LightOS boot (rdinit=).
#
# U-Boot passes lightos/initrd.img with our kernel (lightos/Image, built by
# tools/build_kernel.sh) or ROCKNIX's KERNEL; that one unpacks it over its
# own built-in initramfs, and this script replaces ROCKNIX's /init. It
#   1. asks for each button in turn and logs its key code (keys.txt), then
#      shows any button until KEYS_MIN_SECONDS;
#   2. writes what it found to lightos/logs/boot-N on the FAT partition,
#      with the same counter as ROCKNIX's boots (mount-storage.sh);
#   3. shares that partition over the OTG port, like "LightOS SD via USB";
#   4. reboots when the computer ejects it, or when no computer came.
# U-Boot already kept LIGHTOS.TXT's token in sector 31 of the partition, so
# the reboot goes to ROCKNIX unless the computer armed a new token.
#
# If this script stops, the kernel panics and panic=10 reboots.

export PATH=/lightos/bin
WAIT_HOST=120
WAIT_GONE=20
LOG=/tmp/lightos-init.txt
G=/sys/kernel/config/usb_gadget/lightos

mkdir -p /proc /sys /dev /tmp /flash
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mount -t configfs configfs /sys/kernel/config 2>/dev/null

up() { cut -d' ' -f1 /proc/uptime; }
say() { echo "$*"; echo "$(up) $*" >> $LOG; }
t_init=$(up)

printf '\033[2J\033[H'
say "R36S LightOS (busybox initramfs, $(uname -r))"
say "init started at ${t_init} s"

# The FAT partition (ROCKNIX's /flash): logs, the USB disk, and whether to
# run the guided button test.
part=
i=0
while [ $i -lt 50 ]; do
  part=$(findfs LABEL=ROCKNIX 2>/dev/null) && [ -b "$part" ] && break
  part=
  usleep 100000
  i=$((i + 1))
done
if [ -z "$part" ]; then
  say "No FAT partition labelled ROCKNIX: no logs, no USB disk."
  sleep 10
  reboot -f
fi
guided=no
if mount -t vfat -o ro "$part" /flash; then
  [ -e /flash/lightos/keytest ] && guided=yes
  umount /flash
fi

# 1. Buttons. With lightos/keytest on the card, guided: the screen asks for
# one button at a time, in the order below, and keys.txt gets the key code
# and device each one sent; a step with no press for STEP_SECONDS is
# skipped. Then (or straight away, without keytest) any button shows on the
# screen until KEYS_MIN_SECONDS from the start. POWER comes last: nothing in
# LightOS acts on KEY_POWER, but holding it powers off (the PMIC). RESET is
# a hardware reset and is not asked for.
STEPS='D-pad up
D-pad right
D-pad down
D-pad left
X
A
B
Y
L1
L2
R2
R1
FN
START
SELECT
Left stick, pressed
Right stick, pressed
Volume +
Volume -
POWER, short press only, do not hold it'
STEP_SECONDS=30
KEYS_MIN_SECONDS=10
[ $guided = yes ] && KEYS_MIN_SECONDS=120
RAW=/tmp/keys-raw.txt
KEYS=/tmp/keys.txt
: > $RAW
: > $KEYS
secs() { cut -d. -f1 /proc/uptime; }
lines() { wc -l < $RAW; }

# One reader per input device; an evdev read returns whole 24-byte events:
# time (16), type, code (u16), value (s32). Presses (EV_KEY 1, value 1) go
# to $RAW as "uptime code device".
say ""
readers=
for ev in /dev/input/event*; do
  [ -c "$ev" ] || continue
  name=$(cat /sys/class/input/${ev##*/}/device/name 2>/dev/null)
  say "  ${ev##*/}: $name"
  (
    while :; do
      set -- $(dd if=$ev bs=24 count=1 2>/dev/null | od -An -tu2)
      [ $# -ge 11 ] || exit 0
      [ "$9" = 1 ] && [ "${11}" = 1 ] && echo "$(up) ${10} $name" >> $RAW
    done
  ) &
  readers="$readers $!"
done
sleep 2

t_keys=$(secs)
n_steps=$(echo "$STEPS" | wc -l)
i=0
[ $guided = yes ] || STEPS=
while read -r step; do
  [ -n "$step" ] || continue
  i=$((i + 1))
  seen=$(lines)
  printf '\033[2J\033[H'
  echo "LightOS button test: $i of $n_steps"
  echo ""
  echo "    Press:  $step"
  echo ""
  echo "($STEP_SECONDS s for each button; wait to skip one)"
  echo ""
  tail -n 18 $KEYS
  got=
  tick=0
  while [ $tick -lt $((STEP_SECONDS * 10)) ]; do
    if [ "$(lines)" -gt "$seen" ]; then
      got=$(sed -n "$((seen + 1))p" $RAW)
      break
    fi
    usleep 100000
    tick=$((tick + 1))
  done
  if [ -n "$got" ]; then
    set -- $got
    shift
    code=$1
    shift
    echo "$step: $code ($*)" >> $KEYS
  else
    echo "$step: not pressed" >> $KEYS
  fi
  # Anything else that came with that press (bounce) is not the next step.
  usleep 300000
done <<EOF_STEPS
$STEPS
EOF_STEPS

printf '\033[2J\033[H'
cat $KEYS
echo ""
echo "Free test: any button shows here until $KEYS_MIN_SECONDS s."
seen=$(lines)
while [ $(( $(secs) - t_keys )) -lt $KEYS_MIN_SECONDS ]; do
  now=$(lines)
  if [ "$now" -gt "$seen" ]; then
    sed -n "$((seen + 1)),${now}p" $RAW | while read -r t code dev; do
      echo "  key $code on $dev"
    done
    seen=$now
  fi
  usleep 200000
done
kill $readers 2>/dev/null
killall dd 2>/dev/null
printf '\033[2J\033[H'
say "Button test done ($(( $(secs) - t_keys )) s)."
cat $KEYS >> $LOG

# 2. Logs on the FAT partition.

hardware() {
  echo "== uptime"; cat /proc/uptime
  echo "== uname"; uname -a
  echo "== cmdline"; cat /proc/cmdline
  echo "== LIGHTOS.TXT, first line"
  head -n 1 /flash/LIGHTOS.TXT 2>/dev/null
  echo "== sector 31 of $part (U-Boot's copy of the token it booted)"
  dd if=$part bs=512 skip=31 count=1 2>/dev/null | head -n 1
  echo "== panel node"
  panel=/proc/device-tree/dsi@ff450000/panel@0
  tr '\0' ' ' < $panel/compatible; echo
  [ -e $panel/panel_description ] && echo "panel_description present: the overlay was applied"
  [ -e $panel/panel_description ] && tr '\0' '\n' < $panel/panel_description | head -n 1
  for c in /sys/class/drm/card*-*; do
    [ -d "$c" ] || continue
    echo "== $c"
    echo "status=$(cat $c/status) enabled=$(cat $c/enabled) dpms=$(cat $c/dpms)"
    cat $c/modes
  done
  for b in /sys/class/backlight/*; do
    [ -d "$b" ] || continue
    echo "== $b"
    for f in brightness actual_brightness max_brightness bl_power; do
      echo "$f=$(cat $b/$f)"
    done
  done
  echo "== input"; cat /proc/bus/input/devices
  echo "== cpufreq"
  for f in scaling_governor scaling_cur_freq scaling_available_frequencies \
           scaling_available_governors; do
    echo "$f=$(cat /sys/devices/system/cpu/cpu0/cpufreq/$f 2>/dev/null)"
  done
  echo "== devfreq"
  for d in /sys/class/devfreq/*; do
    [ -d "$d" ] && echo "${d##*/} cur=$(cat $d/cur_freq) available=$(cat $d/available_frequencies)"
  done
  echo "== thermal"
  for z in /sys/class/thermal/thermal_zone*; do
    [ -d "$z" ] && echo "${z##*/} $(cat $z/type)=$(cat $z/temp)"
  done
  echo "== power supply"
  for p in /sys/class/power_supply/*; do
    [ -d "$p" ] && echo "-- ${p##*/}" && cat $p/uevent
  done
  echo "== memory"; cat /proc/meminfo
  echo "== mounts"; cat /proc/mounts
  echo "== block"; cat /proc/partitions
  echo "== usb device controller"; ls /sys/class/udc
}

if mount -t vfat -o rw,noatime "$part" /flash; then
  logs=/flash/lightos/logs
  mkdir -p $logs
  count=$(cat $logs/count 2>/dev/null)
  count=$(( ${count:-0} + 1 ))
  echo $count > $logs/count
  for old in $logs/boot-*; do
    [ -d "$old" ] && [ "${old##*-}" -le $(( count - 5 )) ] && rm -rf "$old"
  done
  dir=$logs/boot-$count
  mkdir -p $dir
  say "Logs: lightos/logs/boot-$count"
  case $(uname -r) in
    *-lightos) kernel="LightOS kernel" ;;
    *) kernel="ROCKNIX's kernel" ;;
  esac
  echo "LightOS stage 1 (busybox initramfs on $kernel $(uname -r))" > $dir/os.txt
  hardware > $dir/hardware.txt 2>&1
  dmesg > $dir/dmesg.txt
  cp $LOG $dir/init.txt
  cp $KEYS $dir/keys.txt
  cp $RAW $dir/keys-raw.txt
  sync
  umount /flash
else
  say "Could not mount $part: no logs."
fi

# 3. The partition over the OTG port.
UDC=$(ls -1 /sys/class/udc 2>/dev/null | head -n1)
if [ -z "$UDC" ] || [ ! -d /sys/kernel/config/usb_gadget ]; then
  say "No USB device controller or configfs: no USB disk."
  sleep 10
  reboot -f
fi

role() {
  for sw in /sys/class/udc/$UDC/device/usb_role/*/role; do
    [ -w "$sw" ] && echo "$1" > "$sw"
  done
}

mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/mass_storage.0
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo 0x0200 > $G/bcdUSB
echo "R36S LightOS" > $G/strings/0x409/manufacturer
echo "R36S SD (LightOS)" > $G/strings/0x409/product
echo "mass storage" > $G/configs/c.1/strings/0x409/configuration
echo 250 > $G/configs/c.1/MaxPower
lun=$G/functions/mass_storage.0/lun.0
echo 1 > $lun/removable
echo 0 > $lun/ro
echo 0 > $lun/cdrom
echo "$part" > $lun/file
ln -s $G/functions/mass_storage.0 $G/configs/c.1/

role device
if ! echo "$UDC" > $G/UDC; then
  say "Could not start the USB disk on $UDC."
  sleep 10
  reboot -f
fi
say ""
say "SD card on the OTG port: plug in the computer"
say "within ${WAIT_HOST} s, eject it when done."

waited=0
seen=no
gone=0
while :; do
  state=$(cat /sys/class/udc/$UDC/state 2>/dev/null)
  file=$(cat $lun/file 2>/dev/null)
  if [ "$state" = configured ]; then
    [ $seen = no ] && say "Computer connected."
    seen=yes
    gone=0
  elif [ $seen = yes ]; then
    gone=$((gone + 1))
  fi
  if [ $seen = yes ] && [ -z "$file" ]; then
    say "Ejected by the computer."
    break
  fi
  if [ $seen = yes ] && [ $gone -ge $WAIT_GONE ]; then
    say "Cable gone for ${WAIT_GONE} s."
    break
  fi
  if [ $seen = no ] && [ $waited -ge $WAIT_HOST ]; then
    say "No computer after ${WAIT_HOST} s."
    break
  fi
  sleep 1
  waited=$((waited + 1))
done

echo "" > $G/UDC 2>/dev/null
role host
say "Rebooting."
sync
sleep 2
reboot -f
